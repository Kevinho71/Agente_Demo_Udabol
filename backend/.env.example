PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# API externa (unica fuente de datos del agente)
EXTERNAL_API_BASE_URL=https://appproyectoproducto.onrender.com
EXTERNAL_API_TIMEOUT_MS=60000
EXTERNAL_API_WARMUP=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS: origenes separados por coma
CORS_ORIGINS=http://localhost:5173

# Memoria de conversacion (sin base de datos)
SESSION_TTL_MS=1800000
MAX_AGENT_STEPS=4
RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_MAX=5

# true = no llama a Gemini (solo para pruebas locales de la interfaz)
MOCK_LLM=false
